{
  "name": "sound-clinic-website",
  "compatibility_date": "2024-05-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Request logs stay visible in the dashboard's Logs tab, matching what was enabled there.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
