{
  "name": "sound-clinic-website",
  "compatibility_date": "2024-05-06",
  // Cron-only worker script — exports no fetch handler, so the site itself keeps being
  // served straight from assets exactly as before. See worker/keepalive.js.
  "main": "worker/keepalive.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
