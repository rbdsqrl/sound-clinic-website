{
  "name": "sound-clinic-website",
  "compatibility_date": "2024-05-06",
  // Worker script adds the cron keepalive on top of the plain static site — its fetch handler
  // just forwards every request to the assets binding below, unchanged. See worker/keepalive.js.
  "main": "worker/keepalive.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Keeps the cron's console.log output (e.g. "keepalive: GET .../health/db -> 200") visible
  // in the dashboard's Logs tab, matching what was enabled there.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
